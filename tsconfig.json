{
    "compilerOptions": {
        "target": "esnext",
        "module": "commonjs",
        "strict": true,
        "esModuleInterop": true,
        "rootDir": "scripts",
        "outDir": "output",
        "sourceMap": true,
        "allowJs": true,
        "lib": ["DOM","ESNext"],
        "noImplicitAny": false,
        "removeComments": true,
        //advanced options  
        "skipLibCheck": false,
        "forceConsistentCasingInFileNames": true,
        "experimentalDecorators": true,
        "useDefineForClassFields": false,
        "emitDecoratorMetadata": true
     }   
    
}
